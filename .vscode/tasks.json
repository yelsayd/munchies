{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "godot: run (PATH)",
      "type": "shell",
      "command": "godot --path \"${workspaceFolder}\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    },
    {
      "label": "godot: run (brew cask)",
      "type": "shell",
      "command": "/Applications/Godot.app/Contents/MacOS/Godot --path \"${workspaceFolder}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    }
  ]
}
